# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RUST_LOG=info,restaurant_backend=debug

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SQLX_OFFLINE=true

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64
JWT_ISSUER=restaurant-backend
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourapp.com
ADMIN_JWT_SECRET=CHANGE_ME_random_32_chars_min
ADMIN_PASSWORD_HASH=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001

# ─── Stripe (Test Mode) ───────────────────────────────────────────────────────
# Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook secret: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs: https://dashboard.stripe.com/test/products
STRIPE_PRICE_ACTIONS_20=price_...
STRIPE_PRICE_ACTIONS_100=price_...
STRIPE_PRICE_ACTIONS_500=price_...
STRIPE_SUCCESS_URL=https://dima-fomin.pl/en/billing/success
STRIPE_CANCEL_URL=https://dima-fomin.pl/en/billing/cancel

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ─── Google Analytics / Search Console ────────────────────────────────────────
GA4_PROPERTY_ID=540966831
GA4_REFRESH_TOKEN=replace_with_refresh_token_from_reconnect
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://ministerial-yetta-fodi999-c58d8823.koyeb.app/auth/google/callback
SEARCH_CONSOLE_SITE_URL=https://dima-fomin.pl/

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=product-images
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxx.r2.dev
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Logging
RUST_LOG=info,restaurant_backend=debug

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3001

# ─── Telegram Bot ("Світло Ікони") ────────────────────────────────────────────
# Optional — leave unset to keep the bot fully disabled; the rest of the
# backend runs normally either way. Get TELEGRAM_BOT_TOKEN from @BotFather.
# NEVER commit a real token/secret here or anywhere else.
TELEGRAM_BOT_TOKEN=
# Production value: @svit_ikony
TELEGRAM_CHANNEL=@svit_ikony
# Required for the webhook to accept any request (fails closed if unset).
# Generate a random string, e.g.: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
