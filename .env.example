# Copy to .env for local development. Never commit real secrets.

# development | staging | production
APP_ENV=development
PORT=8000
RUST_LOG=info
# pretty | json
LOG_FORMAT=pretty

DATABASE_URL=postgres://beauty:beauty@localhost:5432/beauty
MAX_DB_CONNECTIONS=10
RATE_LIMIT_PER_SECOND=50

# Generate with: openssl rand -base64 64  (staging/production refuse weak secrets)
JWT_SECRET=
JWT_ISSUER=beauty-backend
JWT_AUDIENCE=beauty-app
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list. Empty = no browser origin is allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000
